{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mesoforge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "vars": {
    "HEVY_API_BASE_URL": "https://api.hevyapp.com/v1",
    "RECOMMENDATION_MODE": "recommendation-only",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mesoforge",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORKOUT_QUEUE",
        "queue": "mesoforge-workouts",
      },
    ],
    "consumers": [
      {
        "queue": "mesoforge-workouts",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "mesoforge-workouts-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
